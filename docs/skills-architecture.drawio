        <mxCell id="e_filter_to_reg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="tool_filter" target="tool_registry">
