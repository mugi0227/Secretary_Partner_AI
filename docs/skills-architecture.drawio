        <mxCell id="llm" value="&lt;b&gt;Gemini LLM&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;AIが考えて応答を生成&lt;/span&gt;" style="ellipse;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="775" y="710" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="llm_note" value="指示書を読み、ユーザーの意図を理解し、&lt;br&gt;必要に応じてツールを呼び出して処理を実行する" style="text;html=1;fontSize=9;fontColor=#b85450;fontStyle=2;align=center;" vertex="1" parent="1">
