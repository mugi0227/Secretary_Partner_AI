        <!-- プロンプトの6つのパーツ -->
        <mxCell id="p1" value="&lt;b&gt;1. 現在日時&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;ユーザーのタイムゾーンで&lt;br&gt;「今何時か」を伝える&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="635" y="380" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. コアプロンプト&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;AIの性格・口調・安全ルール&lt;br&gt;(全リクエスト共通で常に含む)&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="795" y="380" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. ツール一覧&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;今回使えるツールの名前と&lt;br&gt;日本語の使い方ガイド&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="975" y="380" width="155" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. スキルプロンプト&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;選ばれた分野の専門手順書&lt;br&gt;(例: タスク作成の詳細手順)&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="635" y="445" width="165" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. 作業メモ一覧&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;過去に保存した手順メモの&lt;br&gt;目次 (最新8件)&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="445" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;6. 関連メモ展開&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;今回の質問に関係しそうな&lt;br&gt;メモを2件まで全文展開&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="445" width="155" height="50" as="geometry"/>
        </mxCell>

