        <!-- キーワードマッピング -->
        <mxCell id="keywords" value="&lt;b&gt;キーワード → プロファイル:&lt;/b&gt;&lt;br&gt;「タスク」「TODO」「やること」 → task&lt;br&gt;「プロジェクト」「PJ」 → project&lt;br&gt;「会議」「ミーティング」「アジェンダ」 → meeting&lt;br&gt;「スケジュール」「予定」 → schedule&lt;br&gt;「覚えて」「手順」「メモ」 → memory&lt;br&gt;「できること」「ツール」 → capability&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#999&quot;&gt;※ どれにも当てはまらない → デフォルトで task&lt;/span&gt;" style="text;html=1;fontSize=9;align=left;verticalAlign=top;fillColor=none;fontColor=#7f6000;" vertex="1" parent="1">
