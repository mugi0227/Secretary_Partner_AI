          <mxGeometry x="30" y="940" width="1590" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow_title" value="&lt;b&gt;処理の流れ:&lt;/b&gt; ユーザー発言 → 司令塔(AgentService) → ルーター(キーワードでスキル選択+ツール絞り込み) → 指示書組立(共通ルール+専門手順書+作業メモ) → エージェント起動(選ばれたツールだけ) → Gemini(判断・ツール実行) → 応答" style="text;html=1;fontSize=11;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="50" y="945" width="1560" height="45" as="geometry"/>
