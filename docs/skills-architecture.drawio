        <!-- ADK エージェント                      -->
        <!-- ==================================== -->
        <mxCell id="adk_agent" value="&lt;b&gt;ADK エージェント&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Agent(name=&amp;quot;secretary&amp;quot;,&lt;br&gt;instruction=指示書,&lt;br&gt;tools=許可ツール)&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="745" y="600" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="adk_agent_note" value="Google ADK フレームワークのエージェント。&lt;br&gt;指示書とツールをセットで渡して起動する" style="text;html=1;fontSize=9;fontColor=#527a3a;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="1030" y="600" width="250" height="30" as="geometry"/>
