        <mxCell id="e_llm_to_tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#82b366;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="llm" target="tool_registry">
          <mxGeometry relative="1" as="geometry">
