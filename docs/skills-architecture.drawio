        <!-- ツール呼び出しループ -->
        <mxCell id="tool_calls" value="&lt;span style=&quot;font-size:8px&quot;&gt;ツール呼び出し&lt;br&gt;(create_task 等)&lt;/span&gt;" style="text;html=1;fontSize=9;fontColor=#82b366;fontStyle=2;" vertex="1" parent="1">
