        <!-- ==================================== -->
        <!-- ツール登録簿                           -->
        <!-- ==================================== -->
        <mxCell id="tool_registry" value="&lt;b&gt;ツール登録簿&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;app/tools/ (約60個の関数)&lt;br&gt;task_tools, project_tools,&lt;br&gt;phase_tools, meeting_tools,&lt;br&gt;scheduler_tools, memory_tools,&lt;br&gt;browser_tools, user_tools&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="670" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="tool_registry_note" value="実際にDB操作やAPI呼び出し&lt;br&gt;を行う関数の集まり" style="text;html=1;fontSize=9;fontColor=#527a3a;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="1090" y="772" width="180" height="25" as="geometry"/>
