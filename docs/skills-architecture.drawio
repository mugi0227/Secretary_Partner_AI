        <mxCell id="tool_filter" value="&lt;b&gt;_PROFILE_TOOL_NAMES&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px&quot;&gt;スキルごとの「ツール許可リスト」&lt;br&gt;(使って良いツール名のセット)&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="590" width="190" height="55" as="geometry"/>
