          <mxGeometry x="1320" y="255" width="100" height="15" as="geometry"/>
        </mxCell>
        <mxCell id="leg_files" value="runtime_router.py (ルーティング)&lt;br&gt;secretary_agent.py (指示書組立)&lt;br&gt;secretary_core_prompt.py (共通ルール)&lt;br&gt;secretary_skill_prompts.py (専門手順書)&lt;br&gt;agent_service.py (司令塔)" style="text;html=1;fontSize=8;align=left;fontColor=#666;" vertex="1" parent="1">
